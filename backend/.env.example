# BidSense AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Get a FREE key from https://aistudio.google.com/apikey
# New keys may start with AQ. (auth key) or AIza (standard key) — both are valid
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

UPLOAD_DIR=app/uploads
# Point to your own Excel file with bid history + capability library sheets
DATA_PATH=app/data/dataset.xlsx
# Sheet names and header row offset (default: 2 title rows then column headers)
# BID_HISTORY_SHEET=PS1 – Bid History
# CAPABILITY_SHEET=PS1 – Capability Library
# DATASET_SKIPROWS=2
CHROMA_PERSIST_DIR=app/data/chroma_store

LOG_LEVEL=INFO
# Efficiency mode: ~5 Gemini calls/tender, full-document extraction, batch RAG
LLM_EFFICIENCY_MODE=true
MAX_EXTRACTION_CHARS=250000
MAX_REQUIREMENTS_PER_REQUEST=15
PROPOSAL_COMBINED=true
TOP_K_RAG_RESULTS=4
CHUNK_SIZE=3000
CHUNK_OVERLAP=300
